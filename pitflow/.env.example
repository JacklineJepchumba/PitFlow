# Copy to backend/.env (or pitflow/.env) and fill in. Never commit real keys.
# From backend/:  copy ..\.env.example .env   (Windows)  |  cp ../.env.example .env  (Unix)

DATABASE_URL=postgresql+psycopg2://pitflow:pitflow@localhost:5432/pitflow

# Africa's Talking (sandbox)
AT_USERNAME=sandbox
AT_API_KEY=

# M-Pesa Daraja (sandbox) — payouts off by default
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_PAYOUTS_ENABLED=false

# Vite apps: dashboard (:5173) and care worker PWA (:5174)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# JWT (demo only — change before any real deploy)
JWT_SECRET=pitflow-demo-jwt-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
